# ── apps/backend ───────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:5173

ACCESS_CODE_PEPPER=          # openssl rand -hex 32 · 바꾸면 발급된 통행코드가 전부 무효
BALLOT_JWT_SECRET=           # openssl rand -hex 32
ADMIN_API_KEY=               # openssl rand -hex 32 · 마감·순위공개를 모두 여는 키

DATA_SOURCE=supabase         # supabase | memory
SUPABASE_URL=https://xxxxxxxx.supabase.co   # /rest/v1 붙이지 않는다
SUPABASE_SERVICE_ROLE_KEY=   # sb_secret_... · RLS 전부 우회 · 절대 프론트에 노출 금지

# DATA_SOURCE=memory 일 때만 필요 (없으면 부팅 실패)
# DEMO_SEED_PATH=./seed/demo.json

# ── apps/frontend ──────────────────────────────────────────
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_POLL_ID=mu16          # polls.id 슬러그. uuid 아님
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=    # sb_publishable_... · reveal_state SELECT 권한만
